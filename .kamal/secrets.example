# Copy to .kamal/secrets and fill in (secrets is gitignored).
#
#   cp .kamal/secrets.example .kamal/secrets

# GHCR login — username + PAT (write:packages + read:packages). Not your GitHub password.
# deploy.yml builds on the server (builder.remote) so Mac Docker Desktop need not reach ghcr.io.
# In GitHub Actions, release-deploy.yml injects github.actor + GITHUB_TOKEN.
KAMAL_REGISTRY_USERNAME=
KAMAL_REGISTRY_PASSWORD=

# Deploy target IP or hostname (used by deploy.yml ERB + CI smoke check)
KAMAL_SERVER_IP=

# SSH user on the host (default ubuntu; override via .env or this file)
KAMAL_SSH_USER=ubuntu

# Postgres connection (injected into the app container)
# Kamal accessories: tribetip-postgres (primary) + tribetip-postgres-replica.
# Use container names on the kamal Docker network (not the host's published IP:port).
DB_HOST=tribetip-postgres
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
TRIBETIP_DATABASE_PASSWORD=
# Same password Bitnami accessories use (usually same value as TRIBETIP_DATABASE_PASSWORD)
POSTGRESQL_PASSWORD=
# Bitnami postgres superuser (for admin/restore; usually same as app password)
POSTGRESQL_POSTGRES_PASSWORD=
# Streaming replication user password (primary <-> replica)
POSTGRESQL_REPLICATION_PASSWORD=
DB_REPLICA_HOST=tribetip-postgres-replica
DB_REPLICA_PORT=5432

# Public API base URL and Rails allowed hosts (comma-separated)
TRIBETIP_API_URL=
APP_HOSTS=

# Rails credentials + JWT
RAILS_MASTER_KEY=$(cat config/master.key)
# Generate with: bin/rails secret
DEVISE_JWT_SECRET_KEY=

# --- GitHub Actions (.github/workflows/release-deploy.yml) ---
# Add these as repository secrets (never commit real values):
#   KAMAL_SSH_PRIVATE_KEY
#   KAMAL_SERVER_IP
#   KAMAL_SSH_USER (optional; defaults to ubuntu)
#   DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME
#   DB_REPLICA_HOST, DB_REPLICA_PORT
#   TRIBETIP_DATABASE_PASSWORD, POSTGRESQL_PASSWORD, POSTGRESQL_POSTGRES_PASSWORD, POSTGRESQL_REPLICATION_PASSWORD
#   TRIBETIP_API_URL, APP_HOSTS
#   RAILS_MASTER_KEY
#   DEVISE_JWT_SECRET_KEY
