# Copy to .kamal/secrets and fill in (secrets is gitignored).
#
#   cp .kamal/secrets.example .kamal/secrets

# GHCR login — required for local `bin/kamal setup|deploy`.
# Put real values here (do not leave the $VAR placeholders for local deploys):
#   KAMAL_REGISTRY_USERNAME=<github-username>
#   KAMAL_REGISTRY_PASSWORD=<PAT with write:packages + read:packages>
# Or export them in your shell before running kamal.
# In GitHub Actions, release-deploy.yml injects github.actor + GITHUB_TOKEN.
KAMAL_REGISTRY_USERNAME=
KAMAL_REGISTRY_PASSWORD=

# Deploy target IP or hostname (used by deploy.yml ERB + CI smoke check)
KAMAL_SERVER_IP=

# SSH user on the host (default ubuntu; override via .env or this file)
KAMAL_SSH_USER=ubuntu

# Postgres connection (injected into the app container)
# From Kamal containers on the same Docker network, use the Postgres
# container name and internal port (not the host's published IP:port).
DB_HOST=tribe-tip-postgres
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
TRIBETIP_DATABASE_PASSWORD=

# Public API base URL and Rails allowed hosts (comma-separated)
TRIBETIP_API_URL=
APP_HOSTS=

# Rails credentials + JWT
RAILS_MASTER_KEY=$(cat config/master.key)
# Generate with: bin/rails secret
DEVISE_JWT_SECRET_KEY=

# --- GitHub Actions (.github/workflows/release-deploy.yml) ---
# Add these as repository secrets (never commit real values):
#   KAMAL_SSH_PRIVATE_KEY
#   KAMAL_SERVER_IP
#   KAMAL_SSH_USER (optional; defaults to ubuntu)
#   DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME
#   TRIBETIP_DATABASE_PASSWORD
#   TRIBETIP_API_URL, APP_HOSTS
#   RAILS_MASTER_KEY
#   DEVISE_JWT_SECRET_KEY
